<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>GrowTool77</AssemblyName>
    <RootNamespace>GrowTool77</RootNamespace>
    <ApplicationHighDpiMode>SystemAware</ApplicationHighDpiMode>
    <!-- aura_enet.dll is 64-bit -->
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <!-- [AURA] native bridge, built from Native/ (see Native/build.sh) -->
    <None Update="Native\aura_enet.dll" Link="aura_enet.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
